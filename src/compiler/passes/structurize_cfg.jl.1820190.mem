        0     cond_sources = Dict{LLVM.BasicBlock, Vector{LLVM.BasicBlock}}()
        0     for bb in LLVM.blocks(f)
        0         term = LLVM.terminator(bb)
        0         term isa LLVM.BrInst || continue
        0         LLVM.isconditional(term) || continue
        0         for succ in LLVM.successors(term)
