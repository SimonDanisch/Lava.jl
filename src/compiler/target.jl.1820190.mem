        0     config = get(COMPILER_CONFIGS, h, nothing)
        0     if config !== nothing
        0         return config
        -     end
        0     config = lava_full_compiler_config(; workgroup_size, enable_ray_query, kwargs...)
        0     COMPILER_CONFIGS[h] = config
        0     return config
        - end
        - 
        0 @noinline function lava_full_compiler_config(;
        -         kernel = true,
        -         name = nothing,
        -         # GPUCompiler's `always_inline=true` raises Julia's inline_cost_threshold
