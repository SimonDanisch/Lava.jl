        0     get(state.coopmat_var_contents, var_id, nothing) === m_id && return nothing
        0     encode_instruction!(state.mod.functions, Op.OpStore, var_id, m_id)
        0     state.coopmat_var_contents[var_id] = m_id
        0     return nothing
        - end
