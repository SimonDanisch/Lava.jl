        -         # An external binary that is missing or unrunnable is the tolerated case;
        -         # anything else is our bug. @warn, not @debug: silently shipping every
        -         # module unoptimised is a large, invisible regression.
        0         ex isa Union{Base.IOError, SystemError, Base.ProcessFailedException} || rethrow()
        0         @warn "Lava: spirv-opt invocation failed; returning unoptimized SPIR-V" exception=ex
        -     finally
        0         rm(in_path; force=true)
        0         rm(out_path; force=true)
        -     end
        0     return spirv_bytes  # fallback: return unoptimized
        - end
