        - 
        0     for fn in LLVM.functions(mod)
        0         for bb in LLVM.blocks(fn)
        0             for inst in LLVM.instructions(bb)
        0                 inst isa LLVM.CallInst || continue
        0                 called = LLVM.called_operand(inst)
        0                 called isa LLVM.Function || continue
        -                 # Check: call site returns i8 but definition returns i1
        0                 LLVM.value_type(inst) == i8_ty || continue
        0                 def_ret = LLVM.return_type(LLVM.function_type(called))
        0                 def_ret == i1_ty || continue
        0                 push!(to_fix, (inst, called))
        0             end
        0         end
        0     end
