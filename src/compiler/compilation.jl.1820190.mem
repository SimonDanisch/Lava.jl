        -             zext_val = LLVM.zext!(builder, new_call, i8_ty)
        -             LLVM.replace_uses!(call_inst, zext_val)
        -             LLVM.erase!(call_inst)
        -         end
        0     end
        - 
        0     return nothing
        - end
