        0         src_lines = readlines(file)
        0         lo = max(1, line - 1)
        0         hi = min(length(src_lines), line + 1)
        0         for j in lo:hi
        0             marker = j == line ? " >> " : "    "
        0             println(io, "      │$marker$j: ", src_lines[j])
