        0         s_trim = length(s) > 80 ? s[1:80] : s
        0         prefix = s_trim * "__"
        -     end
        0     base = joinpath(dir, "$(prefix)$(sanitize(kernel_name))__$(h)")
        0     write(base * ".spv", spirv_bytes)
        0     write(base * ".ll", post_pass_ir)
