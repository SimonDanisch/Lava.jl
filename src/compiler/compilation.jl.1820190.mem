        - function lower_unsupported_intrinsics!(mod::LLVM.Module)
        0     to_erase = LLVM.Instruction[]
        - 
        0     for fn in LLVM.functions(mod)
        0         for bb in LLVM.blocks(fn)
        0             for inst in LLVM.instructions(bb)
        0                 inst isa LLVM.CallInst || continue
        0                 called = LLVM.called_operand(inst)
        0                 called isa LLVM.Function || continue
        0                 fname = LLVM.name(called)
        - 
        0                 if startswith(fname, "llvm.memcpy")
        0                     lower_memcpy!(inst)
        0                     push!(to_erase, inst)
        0                 elseif startswith(fname, "llvm.memset")
        0                     lower_memset!(inst)
        0                     push!(to_erase, inst)
        0                 elseif startswith(fname, "llvm.lifetime")
        0                     push!(to_erase, inst)
        -                 end
        0             end
        0         end
        0     end
        - 
        0     for inst in to_erase
        0         LLVM.erase!(inst)
        0     end
        - 
        -     # Remove dead intrinsic declarations
        0     for fn in collect(LLVM.functions(mod))
        0         fname = LLVM.name(fn)
        0         if (startswith(fname, "llvm.memcpy") || startswith(fname, "llvm.memset") ||
        -             startswith(fname, "llvm.lifetime")) && isempty(LLVM.uses(fn))
        0             LLVM.erase!(fn)
        -         end
        0     end
        - end
