        0 function dump_spirv_to_disk(spirv_bytes::Vector{UInt8},
        -                             post_pass_ir::AbstractString,
        -                             kernel_name::AbstractString;
        -                             entry_name::AbstractString="")
        0     dir = get(ENV, "LAVA_SPIRV_DUMP_DIR", "")
        0     isempty(dir) && return nothing
