        - """
        -     extract_call_chains(err_str) -> String
        - 
        - Parse GPUCompiler's InvalidIRError output to extract unique call chains through user code.
        - Deduplicates the repeated stacktraces (GPUCompiler emits one per illegal call, but many
        - share the same user-code path). Returns a compact summary showing:
        - - Each unique user-code call chain (deepest user function → kernel entry)
        - - The reason the deepest function is GPU-incompatible
        - """
        - function extract_call_chains(err_str::String)
        -     # Parse each "Reason: ...\nStacktrace:\n [1] ...\n [2] ..." block
        0     blocks = parse_error_blocks(err_str)
        0     isempty(blocks) && return ""
        - 
        -     # For each block, extract the chain of user functions (skip Base/stdlib internals)
        0     seen_chains = Set{String}()
        0     unique_chains = Vector{Tuple{String, Vector{String}}}()  # (reason, [user_funcs...])
        - 
        0     for (reason, stack_entries) in blocks
        0         user_funcs = String[]
        0         for entry in stack_entries
        -             # Skip Base/stdlib internals — keep user code and Lava code
        0             is_internal = is_base_internal(entry)
        0             if !is_internal
        0                 push!(user_funcs, entry)
        -             end
        0         end
        0         isempty(user_funcs) && continue
        - 
        -         # Deduplicate by the user function chain
        0         chain_key = join(user_funcs, " → ")
        0         if chain_key ∉ seen_chains
        0             push!(seen_chains, chain_key)
        0             push!(unique_chains, (reason, user_funcs))
        -         end
        0     end
        - 
        0     isempty(unique_chains) && return ""
        - 
        -     # Format: show each unique chain compactly
        0     lines = String[]
        0     push!(lines, "Call chain(s) with GPU-incompatible code:")
        0     for (i, (reason, funcs)) in enumerate(unique_chains)
        -         # Show as: kernel! → helper1 → helper2 → [problem] (reason)
        0         short_reason = shorten_reason(reason)
        0         chain = join(reverse(funcs), " → ")
        0         push!(lines, "  $i. $chain")
        0         push!(lines, "     Problem: $short_reason")
        0     end
        - 
        0     return join(lines, "\n")
        - end
