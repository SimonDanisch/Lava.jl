        - function shorten_reason(reason::String)
        0     if occursin("gc_pool_alloc", reason) || occursin("get_pgcstack", reason) ||
        -        occursin("new_gc_frame", reason) || occursin("push_gc_frame", reason) ||
        -        occursin("pop_gc_frame", reason) || occursin("gc_frame_slot", reason)
        0         return "heap allocation (GC)"
        0     elseif occursin("jl_alloc", reason) || occursin("ijl_alloc", reason)
        0         return "heap allocation"
        0     elseif occursin("ijl_pchar_to_string", reason) || occursin("jl_string", reason) ||
        -            occursin("genericmemory_to_string", reason) || occursin("string_to_generic", reason)
        0         return "String allocation"
        0     elseif occursin("dynamic function invocation", reason)
        0         return "dynamic dispatch (type instability)"
        0     elseif occursin("runtime call", reason)
        0         return "runtime function call"
        0     elseif occursin("jl_f_getglobal", reason) || occursin("undefined name", reason)
        0         return "global variable access"
        0     elseif occursin("jl_argument_error", reason)
        0         return "argument validation (allocates)"
        0     elseif occursin("jl_f_throw_methoderror", reason)
        0         return "method lookup failure"
        -     else
        -         # Return first ~80 chars
        0         return length(reason) > 80 ? reason[1:80] * "..." : reason
        -     end
        - end
