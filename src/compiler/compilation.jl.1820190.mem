        - function lower_memset!(inst::LLVM.CallInst)
        0     ops = LLVM.operands(inst)
        0     dst = ops[1]
        0     fill_val = ops[2]  # i8
        0     len_val = ops[3]
        - 
        0     if !(len_val isa LLVM.ConstantInt)
        0         error("Cannot lower memset with non-constant length: $inst")
        -     end
        0     nbytes = convert(Int, len_val)
        - 
        0     T_i8 = LLVM.Int8Type()
        0     T_i32 = LLVM.Int32Type()
        0     T_i64 = LLVM.Int64Type()
