        - 
        -         spirv_disasm = disassemble_spirv(spirv_bytes)
        - 
        -         return CompilationResult(pre_pass_ir, post_pass_ir, spirv_bytes, spirv_disasm,
        -                                  wrapper_name, stage, (1, 1, 1), push_info, source_map)
        -     end
        - end
