        - function parse_error_blocks(err_str::String)
        0     blocks = Vector{Tuple{String, Vector{String}}}()
        -     # Split by "Reason:" — each is one error
        0     parts = split(err_str, "Reason: ")
        0     for part in parts[2:end]  # skip the header before first Reason
        0         lines = split(part, '\n')
        0         reason = strip(String(lines[1]))
        - 
        -         # Parse stacktrace entries: " [N] func_name\n   @ file:line"
        0         stack_entries = String[]
        -         i = 1
        0         while i <= length(lines)
        0             m = match(r"^\s*\[(\d+)\]\s+(.+)$", lines[i])
        0             if m !== nothing
        0                 func_name = strip(String(m.captures[2]))
        -                 # Next line has location
        -                 loc = ""
        0                 if i + 1 <= length(lines)
        0                     lm = match(r"^\s+@ (.+)$", lines[i+1])
        0                     if lm !== nothing
        0                         loc = strip(String(lm.captures[1]))
        0                         i += 1
        -                     end
        -                 end
        0                 entry = isempty(loc) ? func_name : "$func_name @ $loc"
        0                 push!(stack_entries, entry)
        -             end
        0             i += 1
        -         end
        0         push!(blocks, (reason, stack_entries))
        0     end
        0     return blocks
        - end
        - 
        - # Base/stdlib paths to filter out of call chains
        - const BASE_INTERNAL_PATTERNS = [
        -     "/share/julia/", "boot.jl", "Base.jl", "array.jl", "strings/",
        -     "ryu/", "iobuffer.jl", "pointer.jl", "float.jl", "int.jl",
        -     "abstractarray.jl", "essentials.jl", "promotion.jl", "math.jl",
        -     "number.jl", "operators.jl", "reduce.jl", "dict.jl", "set.jl",
        -     "range.jl", "simdloop.jl", "refvalue.jl", "iterators.jl",
        - ]
        - 
        - function is_base_internal(entry::String)
        -     for pat in BASE_INTERNAL_PATTERNS
        -         occursin(pat, entry) && return true
        -     end
        -     return false
        - end
