        -         # RT shader emission doesn't have the multi-OpFunction walker yet;
        -         # keep the old single-OpFunction behavior for now.
        -         run_llvm_passes!(mod, wrapper_fn; force_inline_all=true)
        -         post_pass_ir = string(mod)
